rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default deny for unauthenticated direct client access
    match /{document=**} {
      allow read, write: if false;
    }

    // CRM Admin & Authenticated Team Collections
    match /leads/{leadId} {
      allow read, write: if isAuthenticated();
    }

    match /calls/{callId} {
      allow read, write: if isAuthenticated();
    }

    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    match /projects/{projectId} {
      allow read, write: if isAuthenticated();
    }

    match /team/{memberId} {
      allow read, write: if isAuthenticated();
    }

    match /goals/{goalId} {
      allow read, write: if isAuthenticated();
    }

    match /emailDiscussions/{discId} {
      allow read, write: if isAuthenticated();
    }

    match /callDiscussions/{discId} {
      allow read, write: if isAuthenticated();
    }

    match /conversationDiscussions/{discId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    match /teamInternalFiles/{fileId} {
      allow read, write: if isAuthenticated();
    }

    match /teamPayments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    match /clientPayments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }

    match /documents/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    match /proposals/{proposalId} {
      allow read, write: if isAuthenticated();
    }

    match /pricingCatalog/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /paymentDetails/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /callScripts/{scriptId} {
      allow read, write: if isAuthenticated();
    }

    match /emailScripts/{scriptId} {
      allow read, write: if isAuthenticated();
    }

    match /meetings/{meetingId} {
      allow read, write: if isAuthenticated();
    }

    match /preHiringQuestions/{questionId} {
      allow read, write: if isAuthenticated();
    }

    match /preHiringCandidates/{candidateId} {
      allow read, write: if isAuthenticated();
    }

    // Client Portals - Auth users manage directly; Server proxy handles unauthenticated secure token access via Admin SDK
    match /clientPortals/{portalId} {
      allow read, write: if isAuthenticated();
    }

    // Team Portals - Auth users manage directly; Server proxy handles unauthenticated secure token access via Admin SDK
    match /teamPortals/{portalId} {
      allow read, write: if isAuthenticated();
    }

    // Real-time Chat & Presence Collections
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if true;
    }

    match /portalMessages/{messageId} {
      allow read, write: if true;
    }

    match /portalPresence/{presenceId} {
      allow read, write: if true;
    }

    match /test_public_collection/{docId} {
      allow read, write: if true;
    }
  }
}
