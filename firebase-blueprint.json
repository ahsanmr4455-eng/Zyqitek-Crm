  "firestore": {
    "/clients/{clientId}": { "schema": "clients", "description": "Clients collection" },
    "/leads/{leadId}": { "schema": "leads", "description": "Leads collection" },
    "/projects/{projectId}": { "schema": "projects", "description": "Projects collection" },
    "/calls/{callId}": { "schema": "calls", "description": "Calls collection" },
    "/team/{memberId}": { "schema": "team", "description": "Team members collection" },
    "/goals/{goalId}": { "schema": "goals", "description": "Goals collection" },
    "/emailDiscussions/{emailId}": { "schema": "emailDiscussions", "description": "Email discussions collection" },
    "/callDiscussions/{callId}": { "schema": "callDiscussions", "description": "Call discussions collection" },
    "/conversationDiscussions/{convId}": { "schema": "conversationDiscussions", "description": "Conversation discussions collection" },
    "/tasks/{taskId}": { "schema": "tasks", "description": "Tasks collection" },
    "/invoices/{invoiceId}": { "schema": "invoices", "description": "Invoices collection" },
    "/documents/{docId}": { "schema": "documents", "description": "Documents collection" },
    "/settings/{settingId}": { "schema": "settings", "description": "Settings collection" },
    "/activities/{activityId}": { "schema": "activities", "description": "Activities collection" },
    "/clientPortals/{portalId}": { "schema": "clientPortals", "description": "Client Portals collection" },
    "/teamPortals/{portalId}": { "schema": "teamPortals", "description": "Team Portals collection" },
    "/preHiringQuestions/{questionId}": { "schema": "preHiringQuestions", "description": "Pre-hiring questions collection" },
    "/preHiringCandidates/{candidateId}": { "schema": "preHiringCandidates", "description": "Pre-hiring candidates collection" },
    "/proposals/{proposalId}": { "schema": "proposals", "description": "Proposals collection" },
    "/pricingCatalog/{itemId}": { "schema": "pricingCatalog", "description": "Pricing catalog collection" },
    "/paymentDetails/{itemId}": { "schema": "paymentDetails", "description": "Payment details collection" },
    "/teamInternalFiles/{fileId}": { "schema": "teamInternalFiles", "description": "Team internal files collection" },
    "/teamPayments/{paymentId}": { "schema": "teamPayments", "description": "Team payments collection" },
    "/clientPayments/{paymentId}": { "schema": "clientPayments", "description": "Client payments collection" },
    "/callScripts/{scriptId}": { "schema": "callScripts", "description": "Call scripts collection" },
    "/emailScripts/{scriptId}": { "schema": "emailScripts", "description": "Email scripts collection" },
    "/meetings/{meetingId}": { "schema": "meetings", "description": "Meetings collection" },
    "/conversations/{conversationId}": { "schema": "conversations", "description": "Conversations collection" },
    "/conversations/{conversationId}/messages/{messageId}": { "schema": "portalMessages", "description": "Messages subcollection" },
    "/portalMessages/{messageId}": { "schema": "portalMessages", "description": "Portal messages collection" },
    "/portalPresence/{presenceId}": { "schema": "portalPresence", "description": "Portal presence collection" }
